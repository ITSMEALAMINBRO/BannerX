#!/usr/bin/env bash

# Colors
r='\033[1;91m'
p='\033[1;95m'
y='\033[1;93m'
g='\033[1;92m'
n='\033[0m'
b='\033[1;94m'
c='\033[1;96m'

# Symbols
A='\033[1;92m[\033[1;00m+\033[1;92m]\033[1;92m'

# Icons
SHELL="\uf489"
CMD="\uebc4"

# Username Fetch Logic
if [ -d "/data/data/com.termux/files/usr/" ]; then
    DIR="$HOME/.termux"
else
    DIR="$HOME/.BANNER-X"
fi

USERNAME_FILE="$DIR/usernames.txt"

if [ -f "$USERNAME_FILE" ]; then
    username=$(cat "$USERNAME_FILE")
fi

# Clear screen before showing BannerX
if command -v clear >/dev/null 2>&1; then
    clear
else
    printf '\033c'
fi

# Exit Trap Function
exit_script() {
    echo
    echo -e "${c}              (\_/)"
    echo -e "              (${y}^_^${c})     ${A} ${g}Hey dear${c}"
    echo -e "             ⊂(___)づ  ⋅˚₊‧ ଳ ‧₊˚ ⋅"
    echo
    echo -e " ${A} ${c}Exiting ${g}help menu \033[1;36m"
    echo
    exit 0
}

trap exit_script SIGINT SIGTSTP

echo -e "\n\n                   ${g}Hey ${y}$username"
echo -e "${c}              (\_/)"
echo -e "              (${y}^ω^${c})     ${g}I'm BannerX${c}"
echo -e "             ⊂(___)づ  ⋅˚₊‧ ଳ ‧₊˚ ⋅"
echo
echo -e " ${A} ${c}All Command ${g}BannerX Banner${c}"

# Info Section
echo -e "${b}╭═════════════════⊷"
echo -e "${b}┃ ${CMD} ${y}ᴀʟʟ ᴄᴏᴍᴍᴀɴᴅ"
echo -e "${b}╰═════════════════⊷${n}"
echo

# Command/Alias List
echo -e "${b}╭═════𓊈 ${g}${SHELL} ᴄᴏᴍᴍᴀɴᴅ ${b}𓊉══════════════════════════════⊷"
echo -e "${b}┃ ${p}❏ ${g}help       ${p}[ʙᴀɴɴᴇʀx ʜᴇʟᴘ ᴍᴇɴᴜ]"
echo -e "${b}┃ ${p}❏ ${g}bannerx    ${p}[ᴄʜᴀɴɢᴇ ᴅᴇꜱɪɢɴ]"
echo -e "${b}┃ ${p}❏ ${g}bname      ${p}[ᴄʜᴀɴɢᴇ ʙᴀɴɴᴇʀ ɴᴀᴍᴇ]"
echo -e "${b}┃ ${p}❏ ${g}unistall   ${p}[ᴜɴɪɴꜱᴛᴀʟʟ ꜱᴄʀɪᴘᴛ/ᴛᴏᴏʟꜱ]"
echo -e "${b}┃ ${p}❏ ${g}chat       ${p}[ʙᴀɴɴᴇʀx ɢʟᴏʙᴀʟ ᴄʜᴀᴛ]"
echo -e "${b}┃ ${p}❏ ${g}dev        ${p}[ʀᴇᴘᴏʀᴛ ᴅᴇᴠᴇʟᴏᴘᴇʀ]"
echo -e "${b}┃ ${p}❏ ${g}report     ${p}[ʀᴇᴘᴏʀᴛ ᴅᴇᴠᴇʟᴏᴘᴇʀ]"
echo -e "${b}┃ ${p}❏ ${g}update     ${p}[ᴜᴘᴅᴀᴛᴇ ʙᴀɴɴᴇʀx ʙᴀɴɴᴇʀ]"
echo -e "${b}╰════════════════════════════════════════════════⊷"
echo
echo -e "${b}╭═════𓊈 ${g}${SHELL} ᴍɪɴɪ ᴄᴏᴍᴍᴀɴᴅ ${b}𓊉═════════════════════════⊷"
echo -e "${b}┃ ${p}❏ ${g}ls       ${p}[ʟɪsᴛ ᴀʟʟ]"
echo -e "${b}┃ ${p}❏ ${g}lt       ${p}[ʟɪsᴛ ᴅᴇғᴀᴜʟᴛ]"
echo -e "${b}┃ ${p}❏ ${g}clear    ${p}[ᴄʟᴇᴀʀ sᴄʀᴇᴇɴ ʙᴀɴɴᴇʀ]"
echo -e "${b}┃ ${p}❏ ${g}clear n  ${p}[ᴄʟᴇᴀʀ sᴄʀᴇᴇɴ ᴅᴇғᴀᴜʟᴛ]"
echo -e "${b}┃ ${p}❏ ${g}exit     ${p}[ᴇxɪᴛ ᴅᴇғᴀᴜʟᴛ]"
echo -e "${b}┃ ${p}❏ ${g}exit x   ${p}[ᴇxɪᴛ ᴀᴅᴠᴀɴᴄᴇ]"
echo -e "${b}╰════════════════════════════════════════════════⊷"
