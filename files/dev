type_effect() {
    local text="$1"
    local delay=$2
    local term_width=$(tput cols)
    local text_length=${#text}
    local padding=$(( (term_width - text_length) / 2 ))
    printf "%${padding}s" ""
    for ((i=0; i<${#text}; i++)); do
        printf "${LIME}${BLINK}${text:$i:1}${NC}"
        if (( RANDOM % 3 == 0 )); then
            printf "${CYAN}${LIME} ${NC}"
            sleep 0.05
            printf "\b"
        fi
        sleep "$delay"
    done
    echo
}
